# The ₹9 Custom Pass is OFF by default: every feature is free and the Razorpay
# endpoints return 404. Set to true (and redeploy — it's a build-time flag) to turn it on.
NEXT_PUBLIC_ENABLE_PAYWALL=false

# Razorpay (only used when the paywall is on). Leave the key id empty for Sandbox Mode,
# which shows a "Simulate ₹9 Payment" button instead of real checkout.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Gym finder. Optional: with a Google Maps Platform key (Places API (New) enabled) the
# finder uses Google data — best coverage, ratings, phone numbers. Without it, it uses
# free OpenStreetMap data. Server-side only; never exposed to the browser.
GOOGLE_MAPS_API_KEY=
# Result pages per search (1–3, 20 gyms each). Each page is one billable Google request.
GOOGLE_PAGES=2

# Optional override for the owner's requested simple admin login.
# Leave unset for the owner-selected defaults; set server-only values to change them.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional member summaries and distributed login throttling.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
